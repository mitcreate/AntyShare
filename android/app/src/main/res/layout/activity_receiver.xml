<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back_receiver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/card_bg_border"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/text_white"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥 Receive from Phone"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved to Downloads/AntyShare"
                    android:textColor="@color/emerald_green"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Method 1: Scan QR Code -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_highlight_border"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Method A: Scan Sender QR"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan the QR code shown on the sender phone screen — devices connect and transfer instantly."
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_scan_camera"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/btn_teal_rounded"
                android:text="📷 Open Camera Scanner"
                android:textAllCaps="false"
                android:textColor="@color/bg_main"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Method 2: Manual PIN / IP Entry (For zero camera or bad quality camera) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_border"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔢 Method B: Manual IP / PIN Code"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If your camera cannot scan, enter the Sender IP address or PIN shown on their screen:"
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/et_manual_ip"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#162032"
                android:hint="Sender IP (e.g. 192.168.43.1)"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:paddingHorizontal="14dp"
                android:inputType="textUri"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_connect_manual"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/btn_outline_rounded"
                android:text="⚡ Connect &amp; Receive"
                android:textAllCaps="false"
                android:textColor="@color/neon_teal"
                android:textStyle="bold"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Live Transfer HUD Progress Card -->
        <LinearLayout
            android:id="@+id/layout_receiver_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_border"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_receiver_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receiving file..."
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pb_receiver_transfer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/emerald_green"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_receiver_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ 0.0 MB/s"
                    android:textColor="@color/emerald_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_receiver_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Streaming..."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
