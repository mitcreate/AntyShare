<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Bar with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btn_back_sender"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/card_bg_border"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@color/text_white"
                android:contentDescription="Back"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤 Send to Phone"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Native Wi-Fi Socket Beam (50-80 MB/s)"
                    android:textColor="@color/neon_teal"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Selected Files Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_border"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/tv_sender_selected_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No files selected yet"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tv_sender_total_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select photos, heavy 4K videos, APKs, or documents to beam."
                android:textColor="@color/text_muted"
                android:textSize="12.5sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btn_choose_files"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/btn_teal_rounded"
                android:text="📁 Select Files to Send"
                android:textAllCaps="false"
                android:textColor="@color/bg_main"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- QR Code & Pin Section (Visible when files are chosen) -->
        <LinearLayout
            android:id="@+id/layout_sender_qr_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_highlight_border"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp"
            android:visibility="gone"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan this QR code from Receiver Phone:"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <ImageView
                android:id="@+id/iv_sender_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@color/text_white"
                android:padding="8dp"
                android:contentDescription="Pairing QR Code"
                android:layout_marginBottom="14dp" />

            <!-- Alternative PIN Code for devices without camera -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— OR ENTER MANUAL PIN / IP —"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#162032"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_sender_pin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN: 5821"
                    android:textColor="@color/neon_teal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Transfer HUD Progress Card -->
        <LinearLayout
            android:id="@+id/layout_sender_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_border"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_sender_current_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Streaming file..."
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ProgressBar
                android:id="@+id/pb_sender_transfer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/neon_teal"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sender_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ 0.0 MB/s"
                    android:textColor="@color/emerald_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sender_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/text_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
