<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="24dp"
    android:paddingVertical="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_sheet_dark"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top Badge & Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/badge_circle_teal"
                android:gravity="center"
                android:text="💻"
                android:textSize="22sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incoming File from Laptop"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dialog_device_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Laptop (10.67.6.69) • Instant Transfer"
                    android:textColor="@color/emerald_green"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- File Information Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#162032"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tv_dialog_file_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄"
                android:textSize="32sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dialog_file_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="spotnote-trash-frame.png"
                    android:textColor="@color/text_white"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="middle"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tv_dialog_file_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="323.0 KB • Saves to Downloads/AntyShare"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Trust Checkbox -->
        <CheckBox
            android:id="@+id/cb_dialog_always_allow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Always accept files from this Laptop"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:buttonTint="@color/neon_teal"
            android:layout_marginBottom="18dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_dialog_decline"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_outline_danger"
                android:text="✕ Decline"
                android:textAllCaps="false"
                android:textColor="#FF4D4D"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/btn_dialog_accept"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:background="@drawable/btn_teal_rounded"
                android:text="✓ Accept &amp; Save"
                android:textAllCaps="false"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/bg_main"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
