<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Brand Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="26sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AntyShare"
                    android:textColor="@color/text_white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zero-Cloud Offline Engine"
                    android:textColor="@color/neon_teal"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_device_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg_border"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Android"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Network / IP Status Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_border"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_network_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_network_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Checking local network..."
                android:textColor="@color/text_white"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btn_refresh_network"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/btn_outline_rounded"
                android:text="Refresh"
                android:textAllCaps="false"
                android:textColor="@color/neon_teal"
                android:textSize="11sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- 1. Hero Mode: Connect to PC / Laptop -->
        <LinearLayout
            android:id="@+id/card_pc_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_highlight_border"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻"
                    android:textSize="24sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Connect to PC / Laptop"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero Software Needed • Web Browser Transfer"
                        android:textColor="@color/neon_teal"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Open your phone's instant Web Portal in Chrome or Edge on laptop to beam heavy files back and forth."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_launch_pc"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/btn_teal_rounded"
                android:text="🌐 Start PC Web Portal"
                android:textAllCaps="false"
                android:textColor="@color/bg_main"
                android:textStyle="bold"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 2. Combined Mode: Mobile to Mobile Transfer Hub -->
        <LinearLayout
            android:id="@+id/card_mobile_transfer_hub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg_border"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📱"
                    android:textSize="24sp"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile to Mobile Transfer"
                        android:textColor="@color/text_white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ 50 to 80 MB/s • Offline Wi-Fi • 0 MB Data"
                        android:textColor="@color/emerald_green"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Direct peer-to-peer beam. Tap Send to share files, or Receive to scan sender's QR."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Dual Action Tiles (Side-by-Side Send & Receive) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Send Tile -->
                <LinearLayout
                    android:id="@+id/btn_launch_send"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_send_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📤 SEND"
                        android:textColor="@color/bg_main"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Choose &amp; Beam"
                        android:textColor="#D90A0D14"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Receive Tile -->
                <LinearLayout
                    android:id="@+id/btn_launch_receive"
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_receive_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📥 RECEIVE"
                        android:textColor="@color/bg_main"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan Sender QR"
                        android:textColor="#D90A0D14"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- 3. Quick Access Toolbar: View Received Files -->
        <LinearLayout
            android:id="@+id/btn_main_received_files"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/btn_quick_tile"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📂 View Received Files (Downloads/AntyShare)"
                android:textColor="@color/neon_teal"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Trust Footer Banner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="🛡️ 100% Air-Gapped Offline • Zero Cloud Servers • Zero Trackers\nAntyShare v1.0.0"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
